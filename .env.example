# crm-agents — environment configuration (copy to .env)
# All values are placeholders. No real credentials are included.

# Optional API keys used by individual agents (only if you enable them):
# OPENAI_API_KEY=
# SERP_API_KEY=
# GOOGLE_API_KEY=
# SEARCH_ENGINE_ID=

# SQLite database path used by the agent core
CRM_DB=./crm_agents.db

# Debug mode (true/false)
CRM_DEBUG=false
